<?xml version="1.0" encoding="UTF-8"?>
<sequence name="ErrorResponseSeq" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
    <log level="custom">
        <property name="LOG" value="RESPONSE_OUT (error)"/>
        <property name="correlationId" expression="get-property('correlationId')"/>
        <property name="status" expression="get-property('ERR_HTTP')"/>
    </log>
    <payloadFactory media-type="json">
        <format>{"error":{"code":"$1","message":"$2"},"requestId":"$3","timestamp":"$4"}</format>
        <args>
            <arg evaluator="xml" expression="get-property('ERR_CODE')"/>
            <arg evaluator="xml" expression="get-property('ERR_MSG')"/>
            <arg evaluator="xml" expression="get-property('requestId')"/>
            <arg evaluator="xml" expression="get-property('timestamp')"/>
        </args>
    </payloadFactory>
    <property name="HTTP_SC" expression="get-property('ERR_HTTP')" scope="axis2" type="STRING"/>
    <property name="messageType" value="application/json" scope="axis2"/>
    <header name="X-Correlation-ID" expression="get-property('correlationId')" scope="transport"/>
    <respond/>
</sequence>